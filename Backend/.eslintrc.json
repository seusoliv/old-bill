{
  "env": {
    "browser": true,
    "commonjs": true,
    "jest": true,
    "es6": true
  },
  "extends": [
    "standard",
    "eslint:recommended"
  ],
  "globals": {
    "Atomics": "readonly",
    "SharedArrayBuffer": "readonly"
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 11
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "rules": {
    "semi": [
      2,
      "always"
    ],
    "indent": "off",
    "quotes": [
      "error",
      "double"
    ],
    "object-curly-spacing": [
      "error",
      "never"
    ],
    "space-before-function-paren": [
      "error",
      "never"
    ],
    "sort-imports": "off",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": [
      "error"
    ]
  },
  "overrides": [
    {
      "files": [
        "*.ts"
      ],
      "excludedFiles": []
    }
  ]
}
