{
  "name": "backend",
  "version": "1.0.0",
  "description": "GMB2.0",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/backend/src/server.js",
    "start:container": "node Backend/src/server.js",
    "start:dev": "nodemon dist/backend/src/server.js --exec \"npm run compile\"",
    "compile": "tsc -p tsconfig.json && node dist/backend/src/server.js",
    "build": "tsc -p tsconfig.json",
    "mcp:stdio": "node dist/Backend/src/mcp/stdio.js",
    "lint": "eslint -c .eslintrc.json src",
    "test": "jest"
  },
  "author": "BB-Owner",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.8.1",
    "body-parser": "^2.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "nodemailer": "6.9.16",
    "pdfmake": "0.2.17",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfmake": "^0.2.10",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-promise": "^7.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "typescript": "^5.7.2"
  },
  "jest": {
    "globals": {
      "ts-jest": {
        "tsConfig": "tsconfig.spec.json"
      }
    },
    "verbose": true,
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts"
    ]
  },
  "jest-junit": {
    "outputDirectory": "./out-report",
    "outputName": "junit.xml"
  }
}
